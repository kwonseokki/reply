<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="std.reply.mapper.ReplyMapper">
    <resultMap id="replyResult" type="std.reply.dto.ReplyDTO">
        <result property="id" column="id"/>
        <result property="content" column="content"/>
        <result property="boardId" column="board_id"/>
    </resultMap>
<select id="selectAll" resultMap="replyResult" parameterType="long">
    SELECT * FROM reply where board_id = #{id}
</select>
</mapper>